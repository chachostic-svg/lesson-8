# Скопируйте в server/.env и заполните значения из Turso.
# server/.env в git не попадает (см. server/.gitignore).

# Обязательное: URL удалённой базы, команда `turso db show <name> --url`
# Формат: libsql://<имя-базы>-<орг>.turso.io
TURSO_DATABASE_URL=

# Обязательное: токен доступа, команда `turso db tokens create <name>`
# Токен показывается один раз — сохраните его сразу.
TURSO_AUTH_TOKEN=

# Секрет для подписи JWT. Без него используется зашитый в код значение
# (server/src/services/authService.js) — для продакшена задайте свой.
JWT_SECRET=

# Необязательное, значения по умолчанию указаны в server/src/config/index.js
# PORT=3001
# CORS_ORIGIN=http://localhost:5173